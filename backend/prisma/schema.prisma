generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  id               Int          @id @default(autoincrement())
  name             String       @db.VarChar(255)
  slug             String       @unique @db.VarChar(255)
  parent_id        Int?
  is_active        Boolean?     @default(true)
  created_at       DateTime?    @default(now()) @db.Timestamp(6)
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction, map: "fk_parent_category")
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]
  promotions       promotions[]
}

model order_items {
  id            Int      @id @default(autoincrement())
  order_id      Int
  product_id    Int
  price_at_time Decimal  @db.Decimal(10, 2)
  quantity      Int
  orders        orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_oder")
  products      products @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_item_product")
}

model orders {
  id              Int           @id @default(autoincrement())
  user_id         Int
  total_amount    Decimal       @default(0) @db.Decimal(12, 2)
  discount_amount Decimal       @default(0) @db.Decimal(12, 2)
  promotion_id    Int?
  created_at      DateTime?     @default(now()) @db.Timestamp(6)
  updated_at      DateTime?     @updatedAt
  address         String        @db.VarChar(500)
  note            String?
  phone           String        @db.VarChar(20)
  status          order_status  @default(PENDING)
  order_items     order_items[]
  users           users         @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_oder_user")
  payments        payments[]
  promotions      promotions?   @relation(fields: [promotion_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model payments {
  id               Int            @id @default(autoincrement())
  order_id         Int
  amount           Decimal        @db.Decimal(12, 2)
  transaction_code String?        @db.VarChar(255)
  paid_at          DateTime?      @db.Timestamp(6)
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  method           payment_method
  status           payment_status @default(PENDING)
  bank_code        String?        @db.VarChar(50)
  payment_url      String?
  orders           orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_paymen_order")
}

model product_images {
  id         Int       @id @default(autoincrement())
  product_id Int
  image_url  String
  is_main    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_image_product")
}

model products {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  slug               String               @unique @db.VarChar(255)
  price              Decimal              @db.Decimal(10, 2)
  stock              Int                  @default(0)
  description        String?
  category_id        Int
  is_active          Boolean?             @default(true)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @updatedAt
  cart_items         cart_items[]
  order_items        order_items[]
  product_images     product_images[]
  promotion_products promotion_products[]
  product_reviews    product_reviews[]
  categories         categories           @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_product_category")
}

model users {
  id                    Int                     @id @default(autoincrement())
  email                 String                  @unique @db.VarChar(255)
  password              String                  @db.VarChar(255)
  full_name             String?                 @db.VarChar(255)
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  is_active             Boolean?                @default(true)
  role_id               Int
  updated_at            DateTime?               @updatedAt
  dob                   DateTime?               @db.Date
  gender                String?                 @db.VarChar(10)
  phone                 String?                 @db.VarChar(20)
  cart_items            cart_items[]
  orders                orders[]
  reset_password_tokens reset_password_tokens[]
  product_reviews       product_reviews[]
  roles                 roles                   @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_role")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  id         Int       @id @default(autoincrement())
  user_id    Int
  product_id Int
  quantity   Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  products   products  @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_cart_product")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cart_user")

  @@unique([user_id, product_id], map: "unique_cart_item")
}

model permissions {
  id              Int               @id @default(autoincrement())
  name            String            @unique @db.VarChar(100)
  role_permission role_permission[]
}

model role_permission {
  role_id       Int
  permission_id Int
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  id              Int               @id @default(autoincrement())
  role            String            @unique @db.VarChar(50)
  role_permission role_permission[]
  users           users[]
}

model reset_password_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique @db.VarChar(255)
  expired_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_resetpassword_user")
}

model promotions {
  id                 Int                  @id @default(autoincrement())
  code               String               @unique @db.VarChar(50)
  discount_type      promo_discount_type  @default(PERCENT)
  discount_value     Decimal              @db.Decimal(12, 2)
  product_scope      promo_product_scope  @default(ALL)
  category_id        Int?
  starts_at          DateTime             @default(now()) @db.Timestamp(6)
  ends_at            DateTime             @db.Timestamp(6)
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @updatedAt
  orders             orders[]
  promotion_products promotion_products[]
  categories         categories?          @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model banners {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  link_url   String?   @db.VarChar(1000)
  image_url  String    @db.VarChar(1000)
  sort_order Int       @default(0)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt

  @@index([is_active, sort_order])
}

model store_settings {
  id                 Int      @id @default(autoincrement())
  products_per_page  Int      @default(12)
  products_per_row   Int      @default(4)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @updatedAt
}

model product_reviews {
  id         Int      @id @default(autoincrement())
  product_id Int
  user_id    Int
  rating     Int
  comment    String?
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  products products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, user_id])
  @@index([product_id, created_at])
}

model promotion_products {
  promotion_id Int
  product_id   Int
  promotions   promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  products     products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([promotion_id, product_id])
}

enum promo_discount_type {
  PERCENT
  FIXED_AMOUNT
}

enum promo_product_scope {
  ALL
  CATEGORY
  PRODUCT
}

enum order_status {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum payment_status {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum payment_method {
  COD
  VNPAY
  MOMO
}

model sales {
  id               Int                 @id @default(autoincrement())
  name             String              @db.VarChar(255)
  discount_percent Int
  start_date       DateTime            @db.Timestamp(6)
  end_date         DateTime            @db.Timestamp(6)
  status           Boolean             @default(true)
  apply_type       sale_apply_type     @default(ALL)
  target_id        Int?
  created_at       DateTime            @default(now()) @db.Timestamp(6)
  updated_at       DateTime            @updatedAt
}

enum sale_apply_type {
  ALL
  CATEGORY
  PRODUCT
}
